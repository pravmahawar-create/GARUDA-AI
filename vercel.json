{
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "framework": "vite",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/webhook/:path*", "destination": "https://garuda-ai-xfif.onrender.com/api/webhook/:path*" },
    {
      "source": "/api/auth/:path*",
      "destination": "/api/auth?path=:path*"
    },
    {
      "source": "/api/customer/:path*",
      "destination": "/api/customer?path=:path*"
    },
    {
      "source": "/api/founder/command/:path*",
      "destination": "/api/founder?path=:path*"
    },
    {
      "source": "/api/founder/command",
      "destination": "/api/founder"
    },
    {
      "source": "/api/founder/:path*",
      "destination": "/api/founder?path=:path*"
    },
    {
      "source": "/api/founder",
      "destination": "/api/founder"
    },
    {
      "source": "/api/public-chat",
      "destination": "/api/public-chat"
    },
    {
      "source": "/api/telegram",
      "destination": "/api/telegram"
    },
    {
      "source": "/api/inbound/project-scope",
      "destination": "/api/project-scope"
    },
    {
      "source": "/api/project-scope",
      "destination": "/api/project-scope"
    },
    {
      "source": "/api/proposals/:path*",
      "destination": "/api/proposals?path=:path*"
    },
    {
      "source": "/api/proposals",
      "destination": "/api/proposals"
    },
    {
      "source": "/api/webhook/razorpay",
      "destination": "/api/proposals?action=webhook"
    },
    {
      "source": "/api/:path*",
      "destination": "https://garuda-ai-xfif.onrender.com/api/:path*"
    },
    {
      "source": "/what-is-garuda-ai",
      "destination": "/what-is-garuda-ai/index.html"
    },
    {
      "source": "/garuda-ai",
      "destination": "/garuda-ai/index.html"
    },
    {
      "source": "/chat",
      "destination": "/chat/index.html"
    },
    {
      "source": "/demo",
      "destination": "/demo/index.html"
    },
    {
      "source": "/services/custom-ai-development",
      "destination": "/services/custom-ai-development/index.html"
    },
    {
      "source": "/services/ai-agent-development",
      "destination": "/services/ai-agent-development/index.html"
    },
    {
      "source": "/services/custom-software-development",
      "destination": "/services/custom-software-development/index.html"
    },
    {
      "source": "/services/website-development",
      "destination": "/services/website-development/index.html"
    },
    {
      "source": "/services/saas-mvp-development",
      "destination": "/services/saas-mvp-development/index.html"
    },
    {
      "source": "/services/custom-software-saas-mvp",
      "destination": "/services/custom-software-saas-mvp/index.html"
    },
    {
      "source": "/services/business-automation",
      "destination": "/services/business-automation/index.html"
    },
    {
      "source": "/services/business-workflow-ai-automation",
      "destination": "/services/business-workflow-ai-automation/index.html"
    },
    {
      "source": "/services/rag-development",
      "destination": "/services/rag-development/index.html"
    },
    {
      "source": "/services/whatsapp-telegram-ai-bots",
      "destination": "/services/whatsapp-telegram-ai-bots/index.html"
    },
    {
      "source": "/guides",
      "destination": "/guides/index.html"
    },
    {
      "source": "/guides/ai-agent-vs-chatbot",
      "destination": "/guides/ai-agent-vs-chatbot/index.html"
    },
    {
      "source": "/guides/how-business-workflow-automation-works",
      "destination": "/guides/how-business-workflow-automation-works/index.html"
    },
    {
      "source": "/guides/rag-systems-architecture-implementation-guide",
      "destination": "/guides/rag-systems-architecture-implementation-guide/index.html"
    },
    {
      "source": "/guides/how-to-build-saas-mvp-architecture-timeline",
      "destination": "/guides/how-to-build-saas-mvp-architecture-timeline/index.html"
    },
    {
      "source": "/guides/custom-software-vs-off-the-shelf-software",
      "destination": "/guides/custom-software-vs-off-the-shelf-software/index.html"
    },
    {
      "source": "/guides/automate-whatsapp-business-operations-ai",
      "destination": "/guides/automate-whatsapp-business-operations-ai/index.html"
    },
    {
      "source": "/guides/what-custom-ai-development-actually-involves",
      "destination": "/guides/what-custom-ai-development-actually-involves/index.html"
    },
    {
      "source": "/guides/how-to-plan-ai-automation-project",
      "destination": "/guides/how-to-plan-ai-automation-project/index.html"
    },
    {
      "source": "/guides/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/services/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
