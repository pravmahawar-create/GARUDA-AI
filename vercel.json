{
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "framework": "vite",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/webhook/:path*", "destination": "https://garuda-ai-xfif.onrender.com/api/webhook/:path*" },
    {
      "source": "/api/auth/:path*",
      "destination": "/api/auth?path=:path*"
    },
    {
      "source": "/api/customer/:path*",
      "destination": "/api/customer?path=:path*"
    },
    {
      "source": "/api/public-chat",
      "destination": "/api/public-chat"
    },
    {
      "source": "/api/telegram",
      "destination": "/api/telegram"
    },
    {
      "source": "/api/inbound/project-scope",
      "destination": "/api/project-scope"
    },
    {
      "source": "/api/project-scope",
      "destination": "/api/project-scope"
    },
    {
      "source": "/api/:path*",
      "destination": "https://garuda-ai-xfif.onrender.com/api/:path*"
    },
    {
      "source": "/what-is-garuda-ai",
      "destination": "/what-is-garuda-ai/index.html"
    },
    {
      "source": "/garuda-ai",
      "destination": "/garuda-ai/index.html"
    },
    {
      "source": "/chat",
      "destination": "/chat/index.html"
    },
    {
      "source": "/services/:slug",
      "destination": "/services/:slug/index.html"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
