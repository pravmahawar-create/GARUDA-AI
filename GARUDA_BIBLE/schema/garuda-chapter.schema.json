{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "garuda-chapter.schema.json",
  "title": "GARUDA Bible Chapter",
  "type": "object",
  "required": [
    "schemaVersion",
    "bibleVersion",
    "chapterId",
    "title",
    "status",
    "authorityLevel",
    "sourceReferences",
    "rules"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "minLength": 1 },
    "bibleVersion": { "type": "string", "minLength": 1 },
    "chapterId": { "type": "string", "pattern": "^[0-9]{2}_[A-Z0-9_]+$" },
    "title": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["active", "draft", "deprecated", "locked", "planned"]
    },
    "authorityLevel": {
      "type": "string",
      "enum": ["constitution", "founder_locked", "architecture", "roadmap", "historical_report"]
    },
    "sourceReferences": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "chapterId": { "type": "string" },
          "note": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ruleId", "statement"],
        "properties": {
          "ruleId": { "type": "string", "minLength": 1 },
          "statement": { "type": "string", "minLength": 1 },
          "priority": { "type": "string" },
          "appliesTo": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
