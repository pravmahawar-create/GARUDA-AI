{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "garuda-bible.schema.json",
  "title": "GARUDA Bible Master Schema",
  "type": "object",
  "required": ["schemaVersion", "bibleVersion", "chapters"],
  "properties": {
    "schemaVersion": { "type": "string", "minLength": 1 },
    "bibleVersion": { "type": "string", "minLength": 1 },
    "chapters": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9]{2}_[A-Z0-9_]+$"
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
