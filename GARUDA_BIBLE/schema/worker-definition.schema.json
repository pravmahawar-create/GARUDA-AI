{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "worker-definition.schema.json",
  "title": "GARUDA Worker Definition",
  "type": "object",
  "required": ["workerId", "role", "status", "executionMode", "approvalRequired"],
  "properties": {
    "workerId": { "type": "string", "minLength": 1 },
    "role": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["active", "inactive", "planned", "deprecated"] },
    "executionMode": { "type": "string", "enum": ["read_only", "propose_only", "write_allowed"] },
    "approvalRequired": { "type": "boolean" },
    "provider": { "type": "string" },
    "constraints": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": true
}
