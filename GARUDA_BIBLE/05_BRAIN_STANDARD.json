  "rules": [
    {
      "ruleId": "CH05_RULE_001",
      "statement": "Every brain must declare capabilities, allowed actions, and blocked actions.",
      "priority": "P0",
      "appliesTo": ["architect", "frontend", "backend", "engineering", "tester", "reviewer", "documentation"]
    },
    {
      "ruleId": "CH05_RULE_002",
      "statement": "All brains operate in approval-required mode for write-affecting outcomes.",
      "priority": "P0",
      "appliesTo": ["all"]
    },
    {
      "ruleId": "CH05_RULE_003",
      "statement": "Brain outputs must be reviewable and traceable in reports.",
      "priority": "P1",
      "appliesTo": ["reviewer", "documentation"]
    },
    {
      "ruleId": "CH05_RULE_004",
      "statement": "A brain may report execution success only when a real artifact or command result is supported by verifiable evidence.",
      "priority": "P0",
      "appliesTo": ["all"]
    },
    {
      "ruleId": "CH05_RULE_005",
      "statement": "Test execution requires explicit in-workspace targets, bounded timeouts, shell-disabled invocation, and captured exit evidence.",
      "priority": "P0",
      "appliesTo": ["tester"]
    }
  ]
