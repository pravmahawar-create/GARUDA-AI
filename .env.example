# GARUDA Environment Variables Specification (Placeholders Only — Never Commit Plaintext Secrets)

# Platform Authentication & Connector Configuration (Generic Email / SMTP)
GARUDA_EMAIL_HOST=smtp.example.com
GARUDA_EMAIL_PORT=587
GARUDA_EMAIL_USER=user@example.com
GARUDA_EMAIL_PASS=your_secure_password_placeholder

# Founder dashboard access (configure these in Vercel; never commit real values)
FOUNDER_ACCESS_PASSWORD=use_a_long_unique_password
FOUNDER_SESSION_SECRET=use_a_long_random_secret
# Optional Mongo storage used only by the founder credential store (falls back to FOUNDER_ACCESS_PASSWORD when unset)
# MONGODB_URI=mongodb_connection_string

# AI Engine Provider Configuration
# Supported providers: gemini, openai, ollama, nvidia, fallback
# If GARUDA_LLM_PROVIDER is unset, GARUDA auto-detects nvidia -> gemini -> openai -> fallback.
GARUDA_LLM_PROVIDER=
GARUDA_LLM_MODEL=
GARUDA_GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
GARUDA_OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# AI provider for founder console AND public chatbox (preferred over Gemini when set)
# NVIDIA NIM OpenAI-compatible endpoint: https://integrate.api.nvidia.com/v1
# Public/global model: meta/llama-3.1-70b-instruct (natural, reliable).
# Founder console model (fastLane) defaults to meta/llama-3.1-70b-instruct and
# can be overridden with GARUDA_FOUNDER_NVIDIA_MODEL.
NVIDIA_API_KEY=
GARUDA_NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
GARUDA_FOUNDER_NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# GARUDA Creative Universe — External Creative Providers (all optional; sovereign fallback always available)
# Image generation providers (at least one optional; sovereign SVG renders without any key)
# GEMINI_API_KEY already covers Google Imagen when IMAGEN_ENABLED=true
# IMAGEN_API_KEY=your_imagen_key
# GARUDA_IMAGEN_KEY=your_imagen_key
# IMAGEN_ENABLED=false
# OPENAI_API_KEY=sk-...
# HUGGINGFACE_API_KEY=hf_...
# HF_TOKEN=hf_...
# STABILITY_API_KEY=sk-...
# LOCAL_SD_URL=http://127.0.0.1:7860
# FAL_KEY=your_fal_key
# REPLICATE_API_TOKEN=r8_...
# Video generation providers (all optional; cinematic storyboard generated without any key)
# Primary: RUNWAY_API_KEY (also accepts legacy RUNWAYML_API_SECRET for backward compatibility)
# RUNWAY_API_KEY=your_runway_key
# RUNWAYML_API_SECRET=your_runway_key (legacy alias, prefer RUNWAY_API_KEY)
# LUMA_API_KEY=your_luma_key
# KLING_API_KEY=your_kling_key
# OPENAI_SORA_API_KEY=your_sora_key
# LOCAL_VIDEO_GENERATOR_URL=http://127.0.0.1:8000
# Audio / Voice generation providers (all optional; returns truthful unavailability without key)
# ELEVENLABS_API_KEY=your_elevenlabs_key
# Feature flag — set true to allow Replicate paid live generation (cost per video ~₹5/5s, ~₹60/min). Requires REPLICATE_API_TOKEN.
# FOUNDER_ALLOW_REPLICATE=false

# Customer authentication — Supabase (configure these in Vercel; never commit the service-role/secret key)
# Project URL from Supabase Dashboard > Settings > API.
SUPABASE_URL=https://your-project.supabase.co
# Publishable / anon public key (safe to expose in the browser, used by the serverless API functions).
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Alias accepted for the anon JWT format: SUPABASE_ANON_KEY=eyJ...
# Optional service-role key (NEW: SUPABASE_SECRET_KEY / OLD: SUPABASE_SERVICE_ROLE_KEY).
# Only needed for admin operations (demo account reset, user lookup). Never expose publicly.
# SUPABASE_SECRET_KEY=sb_secret_...
# Optional legacy session signing secret. Customer sessions now use Supabase's own
# access/refresh tokens in an HttpOnly cookie, so this is NOT required to run.
# CUSTOMER_SESSION_SECRET=use_a_different_long_random_secret

# Production Webhook Configuration
GARUDA_WEBHOOK_ENABLED=false
GARUDA_WEBHOOK_ENDPOINT=https://garuda-ai-xfif.onrender.com/api/webhook/payment
GARUDA_WEBHOOK_SECRET=your_webhook_secret_placeholder
GARUDA_WEBHOOK_TIMEOUT_MS=8000

# Razorpay Live Payment Configuration
RAZORPAY_KEY_ID_LIVE=rzp_live_xxx
RAZORPAY_KEY_SECRET_LIVE=xxx
RAZORPAY_WEBHOOK_SECRET_LIVE=whsec_xxx
RAZORPAY_LIVE_ENABLED=true
RAZORPAY_WEBHOOK_URL=https://garuda-ai-xfif.onrender.com/api/webhook/payment/razorpay

# Public payment page (Razorpay Payment Page - domestic India)
GARUDA_PAYMENT_PAGE_URL=https://razorpay.me/@garudaosincompany

# Frontend build receives this as VITE_PAYMENT_URL (set in frontend/.env)
VITE_PAYMENT_URL=https://razorpay.me/@garudaosincompany

# Tutoring web-scan (Telegram: "tutoring leads usa/dubai")
# Real background web research for USA/UAE tutoring centres. Search provider order:
# Google CSE -> SerpAPI -> DuckDuckGo HTML (free, no key). Set at least one of these.
# GOOGLE_CSE_API_KEY=...   (Custom Search JSON API key + GOOGLE_CSE_ID of your search engine)
# GOOGLE_CSE_ID=...
# SERPAPI_KEY=...
# TUTORING_MAX_SITES=20   (max sites scanned per job)
# TUTORING_SCAN_STATUS_PATH= (optional override for scan status file)
