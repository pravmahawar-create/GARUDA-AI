// -----------------------------------------------------------------
// 🧬 SOVEREIGN DYNAMIC CLINICAL PERSONALIZATION & TRANSLATION ENGINE
// -----------------------------------------------------------------
function getPersonalizedDayMenu(dayKey, profile, lang) {
  const base = SEVEN_DAY_MENU[dayKey] || SEVEN_DAY_MENU.monday;
  // Deep clone
  const menu = JSON.parse(JSON.stringify(base));

  const isNonVeg = profile?.diet === "non_veg";
  const isEgg = profile?.diet === "egg" || isNonVeg;
  const isSugar = profile?.conditions?.some(c => /sugar|diabet/i.test(c));
  const isBP = profile?.conditions?.some(c => /bp|hypertens|heart/i.test(c));
  const isLiver = profile?.conditions?.some(c => /liver/i.test(c));
  const isUric = profile?.conditions?.some(c => /uric/i.test(c));
  const isThyroid = profile?.conditions?.some(c => /thyroid/i.test(c));
  const isMuscle = profile?.goal === "muscle_gain";
  const isWeightLoss = profile?.goal === "weight_loss";

  // Calorie & Macro adjustments based on Goal & Diet
  if (isNonVeg && isMuscle) {
    menu.dailyTarget = { calories: 2150, protein: "142g", fiber: "34g", carbs: "190g", fats: "52g" };
  } else if (isNonVeg) {
    menu.dailyTarget = { calories: 1720, protein: "128g", fiber: "35g", carbs: "155g", fats: "44g" };
  } else if (isEgg && isMuscle) {
    menu.dailyTarget = { calories: 1980, protein: "115g", fiber: "38g", carbs: "185g", fats: "48g" };
  } else if (isEgg) {
    menu.dailyTarget = { calories: 1650, protein: "102g", fiber: "38g", carbs: "165g", fats: "42g" };
  } else if (isMuscle) {
    menu.dailyTarget = { calories: 1950, protein: "108g", fiber: "40g", carbs: "205g", fats: "46g" };
  } else if (isWeightLoss) {
    menu.dailyTarget = { calories: 1460, protein: "82g", fiber: "42g", carbs: "145g", fats: "36g" };
  }

  // Clinical Overrides on Meals
  if (isNonVeg) {
    // Modify Breakfast
    if (menu.meals[1]) {
      menu.meals[1].name = lang === "hindi" ? "देसी मसाला 3-एग व्हाइट ऑमलेट व पालक" : lang === "punjabi" ? "ਦੇਸੀ ਮਸਾਲਾ 3-ਆਂਡੇ ਸਫ਼ੈਦੀ ਆਮਲੇਟ ਤੇ ਪਾਲਕ" : lang === "english" ? "Desi Masala 3-Egg White Spinach Omelette" : "Desi Masala 3-Egg White Omelette with Spinach";
      menu.meals[1].calories = 290;
      menu.meals[1].protein = "26.5g";
      menu.meals[1].desc = lang === "hindi" ? "3 अंडे की सफेदी और 1 पूरा अंडा, हरी मिर्च, बारीक कटी शिमला मिर्च और 1 मल्टीग्रेन टोस्ट।" : lang === "punjabi" ? "3 ਆਂਡੇ ਦੀ ਸਫ਼ੈਦੀ, ਹਰੀ ਮਿਰਚ, ਬਾਰੀਕ ਕੱਟੀ ਸ਼ਿਮਲਾ ਮਿਰਚ ਅਤੇ 1 ਮਲਟੀਗ੍ਰੇਨ ਟੋਸਟ।" : lang === "english" ? "3 egg whites + 1 whole egg, bell peppers, green chillies & 1 slice multigrain toast." : "3 egg whites + 1 whole egg, bell peppers, green chillies aur 1 slice multigrain toast.";
      menu.meals[1].benefit = lang === "hindi" ? "लीन मसल प्रोटीन और शून्य शुगर स्पाइक। दोपहर तक संपूर्ण तृप्ति।" : lang === "punjabi" ? "ਲੀਨ ਮਸਲ ਪ੍ਰੋਟੀਨ ਅਤੇ ਜ਼ੀਰੋ ਸ਼ੂਗਰ ਸਪਾਈਕ। ਦੁਪਹਿਰ ਤੱਕ ਪੂਰੀ ਤ੍ਰਿਪਤੀ।" : lang === "english" ? "Pure bioavailable albumin protein for sustained energy and zero glucose spike." : "Pure bioavailable albumin protein for sustained energy and zero glucose spike.";
    }
    // Modify Lunch
    if (menu.meals[3]) {
      menu.meals[3].name = lang === "hindi" ? "आयुर्वेदिक स्टीम्ड चिकन स्टू / फिश करी + 2 ज्वार रोटी" : lang === "punjabi" ? "ਆਯੁਰਵੇਦਿਕ ਸਟੀਮਡ ਚਿਕਨ ਸਟੂ / ਫਿਸ਼ ਕਰੀ + 2 ਜਵਾਰ ਰੋਟੀ" : lang === "english" ? "Ayurvedic Murgh Herb Stew / Light Fish Curry + 2 Jowar Rotis" : "Ayurvedic Light Murgh Stew / Fish Curry + 2 Jowar Rotis";
      menu.meals[3].calories = 520;
      menu.meals[3].protein = "38.5g";
      menu.meals[3].desc = lang === "hindi" ? "कम तेल में पकी चिकन ब्रेस्ट, अदरक-लहसुन, लौकी-गाजर के साथ और 2 ज्वार रोटियां व ककड़ी सलाद।" : lang === "punjabi" ? "ਘੱਟ ਤੇਲ ਵਿੱਚ ਪੱਕੀ ਚਿਕਨ ਬ੍ਰੈਸਟ, ਅਦਰਕ-ਲਸਣ, ਘੀਆ-ਗਾਜਰ ਅਤੇ 2 ਜਵਾਰ ਰੋਟੀਆਂ ਤੇ ਖੀਰਾ ਸਲਾਦ।" : lang === "english" ? "Slow-simmered tender chicken breast with ginger, garlic, veggies and 2 jowar flatbreads." : "Slow-simmered chicken breast with ginger, garlic, bottle gourd, 2 jowar rotis aur kheera salad.";
      menu.meals[3].benefit = lang === "hindi" ? "38.5 ग्राम शुद्ध लीन प्रोटीन — मसल रिकवरी और फैट लॉस दोनों में सर्वोत्तम।" : lang === "punjabi" ? "38.5 ਗ੍ਰਾਮ ਸ਼ੁੱਧ ਪ੍ਰੋਟੀਨ — ਮਸਲ ਰਿਕਵਰੀ ਅਤੇ ਫੈਟ ਲੌਸ ਦੋਵਾਂ ਲਈ ਉੱਤਮ।" : lang === "english" ? "High satiety, 38.5g lean amino acid profile with zero visceral fat accumulation." : "High satiety, 38.5g lean amino acids with zero visceral fat accumulation.";
    }
    // Modify Evening Snack
    if (menu.meals[4]) {
      menu.meals[4].name = lang === "hindi" ? "उबले अंडे (2) काली मिर्च के साथ व ग्रीन टी" : lang === "punjabi" ? "ਉਬਲੇ ਆਂਡੇ (2) ਕਾਲੀ ਮਿਰਚ ਨਾਲ ਤੇ ਗ੍ਰੀਨ ਟੀ" : lang === "english" ? "Boiled Egg Whites (2) with Pepper & Green Tea" : "Boiled Egg Whites (2) with Black Pepper & Green Tea";
      menu.meals[4].protein = "12.0g";
    }
  } else if (isEgg) {
    if (menu.meals[1]) {
      menu.meals[1].name = lang === "hindi" ? "देसी अंडा भुर्जी (2 अंडे) व 2 ज्वार रोटी" : lang === "punjabi" ? "ਦੇਸੀ ਆਂਡਾ ਭੁਰਜੀ (2 ਆਂਡੇ) ਤੇ 2 ਜਵਾਰ ਰੋਟੀ" : lang === "english" ? "Desi Masala Egg Bhurji (2 Eggs) + Jowar Roti" : "Desi Masala Egg Bhurji (2 Eggs) with Jowar Roti";
      menu.meals[1].calories = 310;
      menu.meals[1].protein = "22.5g";
    }
  }

  // Condition Overrides
  if (isSugar) {
    menu.clinicalBadge = lang === "hindi" ? "🩺 डायबिटीज / ब्लड शुगर क्लिनिकल परहेज़ एक्टिव (लो ग्लाइसेमिक शील्ड)" : lang === "punjabi" ? "🩺 ਸ਼ੂਗਰ ਕਲੀਨਿਕਲ ਪਰਹੇਜ਼ ਐਕਟਿਵ (ਲੋਅ ਗਲਾਈਸੈਮਿਕ ਸ਼ੀਲਡ)" : lang === "english" ? "🩺 Clinical Diabetes Protocol Active (Low Glycemic Index)" : "🩺 Clinical Sugar Protocol Active (Low-GI Shield)";
    if (menu.meals[0]) {
      menu.meals[0].name = lang === "hindi" ? "करेला-जामुन व मेथी-दाना गुनगुना अर्क" : lang === "punjabi" ? "ਕਰੇਲਾ-ਜਾਮੁਣ ਤੇ ਮੇਥੀ-ਦਾਣਾ ਕੋਸਾ ਅਰਕ" : lang === "english" ? "Bitter Gourd (Karela) & Fenugreek Metabolic Extract" : "Karela-Jamun & Methi-Dana Warm Elixir";
      menu.meals[0].benefit = lang === "hindi" ? "चारेंटिन व पॉलीपेप्टाइड-पी प्राकृतिक इंसुलिन की तरह काम करते हैं और शुगर स्पाइक रोकते हैं।" : lang === "punjabi" ? "ਚਾਰੈਂਟਿਨ ਤੇ ਪੌਲੀਪੈਪਟਾਈਡ-ਪੀ ਕੁਦਰਤੀ ਇੰਸੁਲਿਨ ਵਾਂਗ ਕੰਮ ਕਰਦੇ ਹਨ।" : lang === "english" ? "Charantin & Polypeptide-p mimic endogenous insulin and suppress fasting blood glucose." : "Charantin aur polypeptide-p fasting blood sugar ko suppress karte hain.";
    }
  } else if (isBP) {
    menu.clinicalBadge = lang === "hindi" ? "🩺 हाई बीपी व हृदय स्वास्थ्य क्लिनिकल परहेज़ एक्टिव (लो सोडियम)" : lang === "punjabi" ? "🩺 ਹਾਈ ਬੀਪੀ ਕਲੀਨਿਕਲ ਪਰਹੇਜ਼ ਐਕਟਿਵ (ਘੱਟ ਸੋਡੀਅਮ)" : lang === "english" ? "🩺 Clinical Hypertension Protocol Active (DASH & Low Sodium)" : "🩺 Clinical High BP Protocol Active (DASH / Low-Sodium)";
    if (menu.meals[0]) {
      menu.meals[0].name = lang === "hindi" ? "अर्जुन की छाल व ताज़ा नारियल पानी का पेय" : lang === "punjabi" ? "ਅਰਜੁਨ ਦੀ ਛਿੱਲ ਤੇ ਤਾਜ਼ਾ ਨਾਰੀਅਲ ਪਾਣੀ" : lang === "english" ? "Terminalia Arjuna & Coconut Electrolyte Water" : "Arjun Chaal & Tender Coconut Infusion";
    }
  } else if (isLiver) {
    menu.clinicalBadge = lang === "hindi" ? "🩺 फैटी लिवर डिटॉक्स क्लिनिकल परहेज़ एक्टिव (शून्य रिफाइंड फैट)" : lang === "punjabi" ? "🩺 ਫੈਟੀ ਲਿਵਰ ਡਿਟੌਕਸ ਪਰਹੇਜ਼ ਐਕਟਿਵ (ਜ਼ੀਰੋ ਤੇਲ-ਘਿਓ)" : lang === "english" ? "🩺 Clinical Hepato-Cleanse Protocol Active" : "🩺 Clinical Fatty Liver Reset Protocol Active";
    if (menu.meals[0]) {
      menu.meals[0].name = lang === "hindi" ? "भूमि-आंवला व गुनगुना नींबू अदरक जल" : lang === "punjabi" ? "ਭੂਮੀ-ਆਂਵਲਾ ਤੇ ਕੋਸਾ ਨਿੰਬੂ ਅਦਰਕ ਪਾਣੀ" : lang === "english" ? "Phyllanthus Niruri (Bhumi-Amla) Liver Cleanse Sip" : "Bhumi-Amla & Warm Lemon-Ginger Cleanse";
    }
  } else if (isUric) {
    menu.clinicalBadge = lang === "hindi" ? "🩺 यूरिक एसिड / गठिया क्लिनिकल परहेज़ एक्टिव (लो प्यूरीन)" : lang === "punjabi" ? "🩺 ਯੂਰਿਕ ਐਸਿਡ ਕਲੀਨਿਕਲ ਪਰਹੇਜ਼ ਐਕਟਿਵ (ਲੋਅ ਪਿਊਰੀਨ)" : lang === "english" ? "🩺 Clinical Low-Purine Protocol Active (Anti-Gout)" : "🩺 Clinical Low-Purine Protocol Active (Anti-Gout)";
  } else if (isThyroid) {
    menu.clinicalBadge = lang === "hindi" ? "🩺 थायरॉयड हार्मोन संतुलन क्लिनिकल परहेज़ एक्टिव (ग्लूटेन-फ्री)" : lang === "punjabi" ? "🩺 ਥਾਇਰਾਇਡ ਸੰਤੁਲਨ ਪਰਹੇਜ਼ ਐਕਟਿਵ (ਗਲੂਟਨ-ਮੁਕਤ)" : lang === "english" ? "🩺 Clinical Thyroid Balance Protocol Active (Gluten-Free & Selenium)" : "🩺 Clinical Thyroid Balance Protocol Active";
  }

  // Full-Page Dynamic Language Translation for Day Banner & Meal Content
  if (lang === "hindi") {
    const hindiDays = {
      monday: { name: "सोमवार", title: "मेटाबॉलिक अग्नि व पेट शुद्धि (अग्नि दीपन)", desc: "सप्ताहांत के भारी खान-पान के बाद आंतों की शुद्धि, लिवर सक्रियण व मेटाबॉलिज्म रीसेट।" },
      tuesday: { name: "मंगलवार", title: "मसल रिकवरी व आंत माइक्रोबायोम पोषण", desc: "उच्च पादप प्रोटीन, प्रोबायोटिक्स और आंतों के मित्र बैक्टीरिया को पोषण देने वाला आहार।" },
      wednesday: { name: "बुधवार", title: "कार्डियो-मेटाबॉलिक शील्ड व रक्त शुद्धि", desc: "कोलेस्ट्रॉल नियंत्रण, धमनियों की सुरक्षा व विषैले तत्वों को बाहर निकालने वाला देसी आहार।" },
      thursday: { name: "गुरुवार", title: "हार्मोन्स संतुलन व तनाव मुक्ति (ओजस वर्धन)", desc: "कोर्टिसोल शांत करने वाला, थायरॉयड-अनुकूल और गहरी ऊर्जा देने वाला पोषण।" },
      friday: { name: "शुक्रवार", title: "ग्लूकोज नियंत्रण व लिवर डिटॉक्स (यकृत शोधन)", desc: "इंसुलिन संवेदनशीलता बढ़ाने और लिवर की चर्बी पिघलाने का अचूक देसी प्लान।" },
      saturday: { name: "शनिवार", title: "हड्डी व जोड़ मजबूती (अस्थि-मज्जा पोषण)", desc: "कैल्शियम, मैग्नीशियम और प्राकृतिक सूजन-रोधी मसालों से भरपूर आहार।" },
      sunday: { name: "रविवार", title: "शाही सात्विक स्वस्थ दावत (सर्व धातु वर्धक)", desc: "स्वादिष्ट फाइव-स्टार जायका बिना भारी क्रीम, मैदा या पाम ऑयल के।" }
    };
    if (hindiDays[dayKey]) {
      menu.dayName = hindiDays[dayKey].name;
      menu.themeTitle = hindiDays[dayKey].title;
      menu.themeDesc = hindiDays[dayKey].desc;
    }
  } else if (lang === "punjabi") {
    const punjabiDays = {
      monday: { name: "ਸੋਮਵਾਰ", title: "ਪਾਚਨ ਅੱਗ ਤੇ ਪੇਟ ਦੀ ਸਫ਼ਾਈ (ਅਗਨੀ ਦੀਪਨ)", desc: "ਭਾਰੀ ਖਾਣੇ ਤੋਂ ਬਾਅਦ ਪੇਟ ਦੀ ਸਫ਼ਾਈ, ਲਿਵਰ ਡਿਟੌਕਸ ਅਤੇ ਮੈਟਾਬੋਲਿਕ ਰੀਸੈਟ।" },
      tuesday: { name: "ਮੰਗਲਵਾਰ", title: "ਮਸਲ ਰਿਕਵਰੀ ਤੇ ਅੰਤੜੀਆਂ ਦੀ ਤਾਕਤ", desc: "ਹਾਈ ਪ੍ਰੋਟੀਨ, ਪ੍ਰੋਬਾਇਓਟਿਕਸ ਅਤੇ ਪੇਟ ਦੇ ਚੰਗੇ ਬੈਕਟੀਰੀਆ ਲਈ ਸ਼ਾਨਦਾਰ ਖੁਰਾਕ।" },
      wednesday: { name: "ਬੁੱਧਵਾਰ", title: "ਦਿਲ ਦੀ ਸਿਹਤ ਤੇ ਖੂਨ ਦੀ ਸਫ਼ਾਈ", desc: "ਕੋਲੈਸਟ੍ਰੋਲ ਕੰਟਰੋਲ, ਨਾੜੀਆਂ ਦੀ ਮਜ਼ਬੂਤੀ ਅਤੇ ਸਰੀਰ ਵਿੱਚੋਂ ਜ਼ਹਿਰੀਲੇ ਤੱਤ ਬਾਹਰ।" },
      thursday: { name: "ਵੀਰਵਾਰ", title: "ਹਾਰਮੋਨ ਸੰਤੁਲਨ ਤੇ ਤਣਾਅ ਮੁਕਤੀ (ਓਜਸ ਵਾਧਾ)", desc: "ਤਣਾਅ ਘਟਾਉਣ, ਥਾਇਰਾਇਡ ਠੀਕ ਰੱਖਣ ਅਤੇ ਤਾਜ਼ਗੀ ਭਰਪੂਰ ਖੁਰਾਕ।" },
      friday: { name: "ਸ਼ੁੱਕਰਵਾਰ", title: "ਸ਼ੂਗਰ ਕੰਟਰੋਲ ਤੇ ਲਿਵਰ ਦੀ ਸਫ਼ਾਈ", desc: "ਇੰਸੁਲਿਨ ਵਧਾਉਣ ਅਤੇ ਲਿਵਰ ਦੀ ਚਰਬੀ ਪਿਘਲਾਉਣ ਦਾ ਖਾਸ ਪਲਾਨ।" },
      saturday: { name: "ਸ਼ਨਿੱਚਰਵਾਰ", title: "ਹੱਡੀਆਂ ਤੇ ਜੋੜਾਂ ਦੀ ਮਜ਼ਬੂਤੀ", desc: "ਕੈਲਸ਼ੀਅਮ, ਮੈਗਨੀਸ਼ੀਅਮ ਅਤੇ ਜੋੜਾਂ ਦੇ ਦਰਦ ਤੋਂ ਰਾਹਤ ਵਾਲਾ ਦੇਸੀ ਆਹਾਰ।" },
      sunday: { name: "ਐਤਵਾਰ", title: "ਸ਼ਾਹੀ ਸਾਤਵਿਕ ਸਿਹਤਮੰਦ ਦਾਅਵਤ", desc: "ਬਿਨਾਂ ਮੈਦੇ ਤੇ ਬਿਨਾਂ ਕਰੀਮ ਤੋਂ ਰਾਇਲ ਸਵਾਦਿਸ਼ਟ ਦੇਸੀ ਖਾਣਾ।" }
    };
    if (punjabiDays[dayKey]) {
      menu.dayName = punjabiDays[dayKey].name;
      menu.themeTitle = punjabiDays[dayKey].title;
      menu.themeDesc = punjabiDays[dayKey].desc;
    }
  } else if (lang === "english") {
    const englishDays = {
      monday: { name: "Monday", title: "Metabolic Fire & Deep Gut Reset", desc: "Flush digestive toxins, awaken hepatic enzymes, and reset cellular metabolism." },
      tuesday: { name: "Tuesday", title: "Muscle Synthesis & Microbiome Rebuild", desc: "Bioavailable amino acids, natural probiotics, and complete gut flora nourishment." },
      wednesday: { name: "Wednesday", title: "Cardio-Metabolic Shield & Vascular Detox", desc: "Lipid profile optimization, arterial flexibility, and anti-inflammatory cellular cleanse." },
      thursday: { name: "Thursday", title: "Endocrine Balance & Nervous System Recovery", desc: "Cortisol reduction, thyroid support, and sustained natural vitality." },
      friday: { name: "Friday", title: "Glycemic Defense & Hepatic Detoxification", desc: "Insulin sensitization, glucose curve flattening, and visceral liver fat mobilization." },
      saturday: { name: "Saturday", title: "Skeletal & Musculoskeletal Rejuvenation", desc: "High calcium bioavailability, magnesium, and restorative anti-arthritic nutrition." },
      sunday: { name: "Sunday", title: "Royal Gourmet Ayurvedic Health Feast", desc: "Five-star royal culinary indulgence with zero refined sugars, maida, or palm oils." }
    };
    if (englishDays[dayKey]) {
      menu.dayName = englishDays[dayKey].name;
      menu.themeTitle = englishDays[dayKey].title;
      menu.themeDesc = englishDays[dayKey].desc;
    }
  }

  return menu;
}

